{
  "default": {
    "paths": ["src/**/**/features/"],
    "require": [
      "src/core/world.js",
      "src/core/hooks.js",
      "src/core/helper.js",
      "src/core/pages/*.js",
      "src/**/**/steps/*.js"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "format": [
      ["html", "cucumber-report.html"],
      "summary",
      "progress-bar",
      "json:./cucumber-report.json"
    ]
  }
}
